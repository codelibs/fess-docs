msgstr "Cache-Ablauf (Sekunden) für Vorschläge beliebter Wörter."

msgid "Permissions for suggestion search log."
msgstr "Berechtigungen für das Vorschlags-Suchprotokoll."

msgid "Interval for system monitor in suggestion."
msgstr "Intervall für die Systemüberwachung bei Vorschlägen."

msgid "Whether LDAP admin is enabled."
msgstr "Gibt an, ob die LDAP-Administration aktiviert ist."

msgid "User filter for LDAP admin."
msgstr "Benutzerfilter für die LDAP-Administration."

msgid "Base DN for LDAP admin user."
msgstr "Base DN für den LDAP-Administrationsbenutzer."

msgid "Object classes for LDAP admin user."
msgstr "Objektklassen für den LDAP-Administrationsbenutzer."

msgid "Role filter for LDAP admin."
msgstr "Rollenfilter für die LDAP-Administration."

msgid "Base DN for LDAP admin role."
msgstr "Base DN für die LDAP-Administrationsrolle."

msgid "Object classes for LDAP admin role."
msgstr "Objektklassen für die LDAP-Administrationsrolle."

msgid "Group filter for LDAP admin."
msgstr "Gruppenfilter für die LDAP-Administration."

msgid "Base DN for LDAP admin group."
msgstr "Base DN für die LDAP-Administrationsgruppe."

msgid "Object classes for LDAP admin group."
msgstr "Objektklassen für die LDAP-Administrationsgruppe."

msgid "Whether to sync password for LDAP admin."
msgstr "Gibt an, ob das Passwort für die LDAP-Administration synchronisiert werden soll."

msgid "Whether to validate LDAP authentication."
msgstr "Gibt an, ob die LDAP-Authentifizierung validiert werden soll."

msgid "Timeout (milliseconds) to establish an LDAP connection. This also bounds the TLS handshake and the initial bind response. 0 or less leaves it to the JDK/OS default."
msgstr "Timeout (Millisekunden) für den Aufbau einer LDAP-Verbindung. Dies begrenzt auch den TLS-Handshake und die erste Bind-Antwort. 0 oder weniger überlässt es dem Standard des JDK/OS."

msgid "Timeout (milliseconds) to wait for an LDAP response after the connection is bound. 0 or less waits indefinitely."
msgstr "Timeout (Millisekunden) für das Warten auf eine LDAP-Antwort, nachdem die Verbindung gebunden wurde. 0 oder weniger wartet unbegrenzt."

msgid "Server side time limit (milliseconds) for an LDAP search. 0 or less means no limit."
msgstr "Serverseitiges Zeitlimit (Millisekunden) für eine LDAP-Suche. 0 oder weniger bedeutet kein Limit."

msgid "Maximum username length for LDAP."
msgstr "Maximale Benutzernamenlänge für LDAP."

msgid "Whether to ignore NetBIOS name in LDAP."
msgstr "Gibt an, ob der NetBIOS-Name in LDAP ignoriert werden soll."

msgid "Whether to allow underscores in LDAP group names."
msgstr "Gibt an, ob Unterstriche in LDAP-Gruppennamen zugelassen werden sollen."

msgid "Whether to use lowercase for LDAP permission names."
msgstr "Gibt an, ob für LDAP-Berechtigungsnamen Kleinbuchstaben verwendet werden sollen."

msgid "Whether to allow empty permissions in LDAP."
msgstr "Gibt an, ob leere Berechtigungen in LDAP zugelassen werden sollen."

msgid "Whether to use samAccountName for LDAP group."
msgstr "Gibt an, ob samAccountName für die LDAP-Gruppe verwendet werden soll."

msgid "Whether LDAP role search for user is enabled."
msgstr "Gibt an, ob die LDAP-Rollensuche für Benutzer aktiviert ist."

msgid "Whether LDAP role search for group is enabled."
msgstr "Gibt an, ob die LDAP-Rollensuche für Gruppen aktiviert ist."

msgid "Whether LDAP role search for role is enabled."
msgstr "Gibt an, ob die LDAP-Rollensuche für Rollen aktiviert ist."

