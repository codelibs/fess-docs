msgid "Default query type."
msgstr "기본 쿼리 타입."

msgid "Tie breaker value for dismax queries."
msgstr "dismax 쿼리의 타이 브레이커 값."

msgid "Minimum should match value for boolean queries."
msgstr "불리언 쿼리의 minimum should match 값."

msgid "Number of expansions for prefix queries."
msgstr "접두사 쿼리의 확장 수."

msgid "Slop value for prefix queries."
msgstr "접두사 쿼리의 슬롭 값."

msgid "Prefix length for fuzzy queries."
msgstr "퍼지 쿼리의 접두사 길이."

