msgstr "패싯 필드의 크기."

msgid "Upper clamp for facet.size (applied at the search chokepoint)."
msgstr "facet.size 의 상한 클램프(검색 초크포인트에서 적용)."

msgid "Minimum document count for facet fields."
msgstr "패싯 필드의 최소 문서 수."

msgid "Upper clamp for facet.minDocCount (applied at the search chokepoint)."
msgstr "facet.minDocCount 의 상한 클램프(검색 초크포인트에서 적용)."

