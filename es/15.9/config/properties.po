# Translations for the generated configuration properties page.
#
# msgid is the English text from fess_config.properties. Leave msgstr empty to
# render the English. Regenerate with tools/update_properties_doc.sh, which adds
# new entries and keeps the translations already here.
msgid ""
msgstr ""
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Core"
msgstr "Núcleo"

msgid "The title of the domain for logging and display."
msgstr "Título del dominio para el registro y la visualización."

msgid "Search Engine"
msgstr "Motor de búsqueda"

msgid "The type of search engine backend (e.g., default, opensearch)."
msgstr "Tipo de backend del motor de búsqueda (p. ej., default, opensearch)."

msgid "The URL of the search engine HTTP endpoint. For IPv6 environments, use brackets around the IPv6 address (e.g., http://[::1]:9200)"
msgstr "URL del endpoint HTTP del motor de búsqueda. En entornos IPv6, use corchetes alrededor de la dirección IPv6 (p. ej., http://[::1]:9200)"

msgid "Path to SSL certificate authorities for secure HTTP connections."
msgstr "Ruta a las autoridades de certificación SSL para las conexiones HTTP seguras."

msgid "Username for authenticating to the search engine."
msgstr "Nombre de usuario para autenticarse en el motor de búsqueda."

msgid "Password for authenticating to the search engine."
msgstr "Contraseña para autenticarse en el motor de búsqueda."

msgid "Interval (ms) for heartbeat checks to the search engine."
msgstr "Intervalo (ms) de las comprobaciones de heartbeat al motor de búsqueda."

msgid "Cipher algorithm used for encryption."
msgstr "Algoritmo de cifrado utilizado para el cifrado."

msgid "Secret key for encryption (change this value for production)."
msgstr "Clave secreta para el cifrado (cambie este valor en producción)."

msgid "Algorithm for digest calculation."
msgstr "Algoritmo para el cálculo del digest."

msgid "Password hashing (new mechanism, Spring Security v5.8 compatible) Supported: bcrypt (only, as of now)"
msgstr "Hash de contraseñas (nuevo mecanismo, compatible con Spring Security v5.8) Admitido: bcrypt (únicamente, por ahora)"

msgid "BCrypt cost (log rounds). 10 matches Spring Security v5.8 default. Range: 4-31."
msgstr "Costo de BCrypt (rondas logarítmicas). 10 coincide con el valor predeterminado de Spring Security v5.8. Rango: 4-31."

msgid "Lazy re-hashing on successful login for legacy hashes."
msgstr "Re-hash diferido al iniciar sesión correctamente para los hashes heredados."

msgid "NOTE: app.digest.algorithm is kept for LEGACY password verification only (pre-upgrade hashes that have no {id} prefix). Do not use for new passwords. Regex pattern for properties to encrypt."
msgstr "NOTA: app.digest.algorithm se conserva únicamente para la verificación HEREDADA de contraseñas (hashes anteriores a la actualización que no tienen el prefijo {id}). No lo utilice para contraseñas nuevas. Patrón de expresión regular de las propiedades que se cifran."

msgid "Regex pattern for sensitive values to mask in debug logs (case-insensitive match against property/env keys)."
msgstr "Patrón de expresión regular de los valores sensibles que se enmascaran en los registros de depuración (coincidencia sin distinguir mayúsculas y minúsculas con las claves de propiedades y de variables de entorno)."

msgid "Extension names for application customization."
msgstr "Nombres de extensiones para la personalización de la aplicación."

msgid "Audit log format."
msgstr "Formato del registro de auditoría."

msgid "Script audit log settings."
msgstr "Configuración del registro de auditoría de scripts."

msgid "Maximum characters of script text kept in a script audit log entry; longer text is truncated."
msgstr "Número máximo de caracteres del texto del script que se conservan en una entrada del registro de auditoría de scripts; el texto más largo se trunca."

msgid "JVM options for the crawler process."
msgstr "Opciones de JVM para el proceso del rastreador."

msgid "JVM options (newline-separated) passed to the suggest creator child process."
msgstr "Opciones de JVM (separadas por saltos de línea) que se pasan al proceso hijo del creador de sugerencias."

msgid "JVM options for the chunk vector indexer process. Heap budget. This child JVM is only started while the \"Content Chunk Vector Indexer\" job runs, so a generous -Xmx costs nothing when content chunking is off. The live set is dominated by the in-flight batches, each of which retains, per document, the full _source, the document's chunk strings, and the document's embedding vectors: content_chunker.job.bulk_size          (default   20) x content_chunker.max_chunks_per_document (default 1000) x content_chunker.embedding.dimension  (default  768) x 4 bytes per float x content_chunker.job.concurrency      (default    2) = ~117 MB of vectors alone, before chunk strings and document sources. With the shipped defaults the worst case is roughly 190-250 MB live (and ~235 MB of vectors alone at dimension=1536), which does not fit a 256 MB heap with any GC headroom. Raise -Xmx further if you raise bulk_size, max_chunks_per_document, concurrency, or the embedding dimension."
msgstr "Opciones de JVM para el proceso del indexador de vectores de chunks. Presupuesto de heap. Esta JVM hija solo se inicia mientras se ejecuta el trabajo \"Content Chunk Vector Indexer\", por lo que un -Xmx generoso no cuesta nada cuando la división del contenido en chunks está desactivada. El conjunto vivo está dominado por los lotes en curso, cada uno de los cuales conserva, por documento, el _source completo, las cadenas de chunks del documento y los vectores de embedding del documento: content_chunker.job.bulk_size (valor predeterminado 20) x content_chunker.max_chunks_per_document (valor predeterminado 1000) x content_chunker.embedding.dimension (valor predeterminado 768) x 4 bytes por float x content_chunker.job.concurrency (valor predeterminado 2) = ~117 MB solo de vectores, antes de las cadenas de chunks y los documentos de origen. Con los valores predeterminados incluidos, el peor caso es de aproximadamente 190-250 MB vivos (y ~235 MB solo de vectores con dimension=1536), lo que no cabe en un heap de 256 MB con ningún margen para el GC. Aumente -Xmx todavía más si aumenta bulk_size, max_chunks_per_document, concurrency o la dimensión del embedding."

msgid "JVM options for the thumbnail process."
msgstr "Opciones de JVM para el proceso de miniaturas."

msgid "Job"
msgstr "Trabajo"

msgid "System job IDs for scheduled jobs."
msgstr "IDs de trabajos del sistema para los trabajos programados."

msgid "Template for web crawler job title."
msgstr "Plantilla del título del trabajo del rastreador web."

msgid "Template for file crawler job title."
msgstr "Plantilla del título del trabajo del rastreador de archivos."

msgid "Template for data crawler job title."
msgstr "Plantilla del título del trabajo del rastreador de almacén de datos."

msgid "Script template for job execution."
msgstr "Plantilla de script para la ejecución de trabajos."

msgid "Maximum number of crawler processes."
msgstr "Número máximo de procesos del rastreador."

msgid "Default script language for jobs."
msgstr "Lenguaje de script predeterminado para los trabajos."

msgid "Pattern to filter system properties for jobs."
msgstr "Patrón para filtrar las propiedades del sistema para los trabajos."

msgid "Number of processors to use."
msgstr "Número de procesadores que se utilizan."

msgid "Path to Java command."
msgstr "Ruta del comando Java."

msgid "Path to Python command."
msgstr "Ruta del comando Python."

msgid "Encoding for file paths."
msgstr "Codificación de las rutas de archivo."

msgid "Whether to use a dedicated temporary directory."
msgstr "Indica si se utiliza un directorio temporal dedicado."

msgid "Maximum length of log output."
msgstr "Longitud máxima de la salida del registro."

msgid "Adaptive load control value."
msgstr "Valor del control de carga adaptativo."

msgid "CPU threshold (%) for web request load control. Returns 429 when CPU >= this value. (100: disabled)"
msgstr "Umbral de CPU (%) para el control de carga de las solicitudes web. Devuelve 429 cuando la CPU >= este valor. (100: deshabilitado)"

msgid "CPU threshold (%) for API request load control. Returns 429 when CPU >= this value. (100: disabled)"
msgstr "Umbral de CPU (%) para el control de carga de las solicitudes de API. Devuelve 429 cuando la CPU >= este valor. (100: deshabilitado)"

msgid "Interval (seconds) for monitoring OpenSearch CPU load."
msgstr "Intervalo (segundos) para monitorear la carga de CPU de OpenSearch."

msgid "Supported languages."
msgstr "Idiomas admitidos."

msgid "Length of API access token."
msgstr "Longitud del token de acceso de la API."

msgid "API access token request parameter."
msgstr "Parámetro de solicitud del token de acceso de la API."

msgid "Permissions for API admin access."
msgstr "Permisos para el acceso de administración de la API."

msgid "Accepted referers for API search."
msgstr "Referers aceptados para la búsqueda por API."

msgid "Whether to enable scroll for API search."
msgstr "Indica si se habilita scroll para la búsqueda por API."

msgid "Whether to enable the end-user export of search results (CSV/JSON) at /api/v2/documents/export."
msgstr "Indica si se habilita la exportación por parte del usuario final de los resultados de búsqueda (CSV/JSON) en /api/v2/documents/export."

msgid "Maximum number of documents written by one search result export."
msgstr "Número máximo de documentos que escribe una exportación de resultados de búsqueda."

msgid "Fields written by the search result export (comma-separated). A field that is not an API response field is ignored."
msgstr "Campos que escribe la exportación de resultados de búsqueda (separados por comas). Se ignora un campo que no es un campo de respuesta de la API."

msgid "Maximum number of search result exports per minute for each user (each client IP for a guest). 0 or less disables the limit."
msgstr "Número máximo de exportaciones de resultados de búsqueda por minuto para cada usuario (cada IP de cliente en el caso de un invitado). 0 o menos deshabilita el límite."

msgid "Headers for API JSON response. Access-Control-* and Timing-Allow-Origin are ignored here (CORS is controlled by api.cors.* / CorsFilter). Do not set Vary."
msgstr "Encabezados de la respuesta JSON de la API. Access-Control-* y Timing-Allow-Origin se ignoran aquí (CORS se controla mediante api.cors.* / CorsFilter). No establezca Vary."

msgid "Whether to include exceptions in API JSON response."
msgstr "Indica si se incluyen excepciones en la respuesta JSON de la API."

msgid "Headers for API GSA response. Access-Control-* and Timing-Allow-Origin are ignored here (CORS is controlled by api.cors.* / CorsFilter). Do not set Vary."
msgstr "Encabezados de la respuesta GSA de la API. Access-Control-* y Timing-Allow-Origin se ignoran aquí (CORS se controla mediante api.cors.* / CorsFilter). No establezca Vary."

msgid "Whether to include exceptions in API GSA response."
msgstr "Indica si se incluyen excepciones en la respuesta GSA de la API."

msgid "Headers for API dashboard response. Access-Control-* and Timing-Allow-Origin are ignored here (CORS is controlled by api.cors.* / CorsFilter). Do not set Vary."
msgstr "Encabezados de la respuesta del panel de control de la API. Access-Control-* y Timing-Allow-Origin se ignoran aquí (CORS se controla mediante api.cors.* / CorsFilter). No establezca Vary."

msgid "Allowed origins for CORS. \"*\" returns a literal \"*\" (the request Origin is NOT reflected) and disables credentials. Set explicit origins (newline- or comma-separated) to allow credentialed cross-origin access."
msgstr "Orígenes permitidos para CORS. \"*\" devuelve un \"*\" literal (el Origin de la solicitud NO se refleja) y deshabilita las credenciales. Establezca orígenes explícitos (separados por saltos de línea o comas) para permitir el acceso entre orígenes con credenciales."

msgid "Allowed HTTP methods for CORS."
msgstr "Métodos HTTP permitidos para CORS."

msgid "Max age for CORS preflight requests."
msgstr "Edad máxima (max age) de las solicitudes preflight de CORS."

msgid "Allowed request headers for CORS preflight. A static list is returned (Access-Control-Request-Headers is not reflected). Includes X-Fess-CSRF-Token for cross-origin SPAs sending the CSRF token."
msgstr "Encabezados de solicitud permitidos para el preflight de CORS. Se devuelve una lista estática (Access-Control-Request-Headers no se refleja). Incluye X-Fess-CSRF-Token para las SPA de origen cruzado que envían el token CSRF."

msgid "Whether to allow credentials for CORS. Honored only for an exact match of an explicit Origin; ignored when api.cors.allow.origin is \"*\"."
msgstr "Indica si se permiten las credenciales para CORS. Solo se respeta cuando coincide exactamente con un Origin explícito; se ignora cuando api.cors.allow.origin es \"*\"."

msgid "Whether to enable JSONP for API."
msgstr "Indica si se habilita JSONP para la API."

msgid "Fields for API ping to search engine."
msgstr "Campos para el ping de la API al motor de búsqueda."

msgid "Rate Limiting"
msgstr "Límite de tasa"

msgid "Whether rate limiting is enabled."
msgstr "Indica si el límite de tasa está habilitado."

msgid "Maximum number of requests allowed per window."
msgstr "Número máximo de solicitudes permitidas por ventana."

msgid "Window size in milliseconds."
msgstr "Tamaño de la ventana en milisegundos."

msgid "Duration in milliseconds to block IP when limit exceeded."
msgstr "Duración en milisegundos del bloqueo de una IP cuando se excede el límite."

msgid "Retry-After header value in seconds."
msgstr "Valor del encabezado Retry-After en segundos."

msgid "Comma-separated list of whitelisted IPs (e.g., 127.0.0.1,::1)."
msgstr "Lista de IPs incluidas en la lista de permitidos, separadas por comas (p. ej., 127.0.0.1,::1)."

msgid "Comma-separated list of blocked IPs."
msgstr "Lista de IPs bloqueadas, separadas por comas."

msgid "Comma-separated list of trusted proxy IPs. Only trust X-Forwarded-For/X-Real-IP from these IPs."
msgstr "Lista de IPs de proxies de confianza, separadas por comas. Solo se confía en X-Forwarded-For/X-Real-IP procedentes de estas IPs."

msgid "Number of requests between cleanup operations to prevent memory leaks."
msgstr "Número de solicitudes entre las operaciones de limpieza para evitar fugas de memoria."

msgid "Virtual Host: Host:fess.codelibs.org=fess"
msgstr "Host virtual: Host:fess.codelibs.org=fess"

msgid "Hostname for the HTTP proxy server."
msgstr "Nombre de host del servidor proxy HTTP."

msgid "Port number for the HTTP proxy server (e.g., 8080)."
msgstr "Número de puerto del servidor proxy HTTP (p. ej., 8080)."

msgid "Username for HTTP proxy authentication."
msgstr "Nombre de usuario para la autenticación del proxy HTTP."

msgid "Password for HTTP proxy authentication."
msgstr "Contraseña para la autenticación del proxy HTTP."

msgid "Maximum size (bytes) for HTTP file uploads."
msgstr "Tamaño máximo (bytes) de las cargas de archivos HTTP."

msgid "Threshold size (bytes) for HTTP file upload buffering."
msgstr "Tamaño umbral (bytes) para el almacenamiento en búfer de las cargas de archivos HTTP."

msgid "Maximum number of files allowed per HTTP upload."
msgstr "Número máximo de archivos permitidos por carga HTTP."

msgid "Index"
msgstr "Índice"

msgid "Crawler Common"
msgstr "Rastreador común"

msgid "Number of threads for HTTP crawling."
msgstr "Número de hilos para el rastreo HTTP."

msgid "Serializer type for crawler data (e.g., kryo)."
msgstr "Tipo de serializador para los datos del rastreador (p. ej., kryo)."

msgid "Maximum length of site name in documents."
msgstr "Longitud máxima del nombre del sitio en los documentos."

msgid "Encoding for site names in documents."
msgstr "Codificación de los nombres de sitio en los documentos."

msgid "Hostname to use when unknown in documents."
msgstr "Nombre de host que se utiliza cuando es desconocido en los documentos."

msgid "Whether to use site encoding for English documents."
msgstr "Indica si se utiliza la codificación del sitio para los documentos en inglés."

msgid "Whether to append data to documents."
msgstr "Indica si se anexan datos a los documentos."

msgid "Whether to append filename to documents."
msgstr "Indica si se anexa el nombre de archivo a los documentos."

msgid "Maximum size of alphanumeric terms in documents."
msgstr "Tamaño máximo de los términos alfanuméricos en los documentos."

msgid "Maximum size of symbol terms in documents."
msgstr "Tamaño máximo de los términos de símbolos en los documentos."

msgid "Whether to remove duplicate terms in documents."
msgstr "Indica si se eliminan los términos duplicados en los documentos."

msgid "Unicode space characters for document parsing."
msgstr "Caracteres de espacio Unicode para el análisis de documentos."

msgid "Unicode full stop characters for document parsing."
msgstr "Caracteres de punto final Unicode para el análisis de documentos."

msgid "Encoding for crawling data."
msgstr "Codificación de los datos de rastreo."

msgid "Supported web protocols for crawling."
msgstr "Protocolos web admitidos para el rastreo."

msgid "Supported file protocols for crawling."
msgstr "Protocolos de archivo admitidos para el rastreo."

msgid "Pattern for environment variable keys in crawling data."
msgstr "Patrón de las claves de variables de entorno en los datos de rastreo."

msgid "Whether to ignore robots.txt during crawling."
msgstr "Indica si se ignora robots.txt durante el rastreo."

msgid "Whether to ignore robots meta tags during crawling."
msgstr "Indica si se ignoran las etiquetas meta robots durante el rastreo."

msgid "Whether to ignore content exceptions during crawling."
msgstr "Indica si se ignoran las excepciones de contenido durante el rastreo."

msgid "HTTP status codes considered as failure URLs."
msgstr "Códigos de estado HTTP considerados como URLs de fallo."

msgid "Interval (seconds) for system monitor during crawling."
msgstr "Intervalo (segundos) del monitor del sistema durante el rastreo."

msgid "Whether to ignore idle threads in hot thread monitoring."
msgstr "Indica si se ignoran los hilos inactivos en el monitoreo de hot threads."

msgid "Interval for hot thread monitoring (e.g., 500ms)."
msgstr "Intervalo del monitoreo de hot threads (p. ej., 500ms)."

msgid "Number of snapshots for hot thread monitoring."
msgstr "Número de instantáneas del monitoreo de hot threads."

msgid "Number of threads for hot thread monitoring."
msgstr "Número de hilos del monitoreo de hot threads."

msgid "Timeout for hot thread monitoring (e.g., 30s)."
msgstr "Tiempo de espera del monitoreo de hot threads (p. ej., 30s)."

msgid "Type of hot thread monitoring (e.g., cpu)."
msgstr "Tipo de monitoreo de hot threads (p. ej., cpu)."

msgid "Metadata fields to exclude from document content."
msgstr "Campos de metadatos que se excluyen del contenido del documento."

msgid "Mapping for document metadata names."
msgstr "Mapeo de los nombres de metadatos del documento."

msgid "Crawler HTML"
msgstr "Rastreador HTML"

msgid "XPath to extract main content from HTML documents."
msgstr "XPath para extraer el contenido principal de los documentos HTML."

msgid "XPath to extract language attribute from HTML documents."
msgstr "XPath para extraer el atributo de idioma de los documentos HTML."

msgid "XPath to extract digest (description) from HTML documents."
msgstr "XPath para extraer el digest (descripción) de los documentos HTML."

msgid "XPath to extract canonical URL from HTML documents."
msgstr "XPath para extraer la URL canónica de los documentos HTML."

msgid "HTML tags to prune (remove) during document processing."
msgstr "Etiquetas HTML que se podan (eliminan) durante el procesamiento de documentos."

msgid "Maximum length of digest extracted from HTML documents."
msgstr "Longitud máxima del digest extraído de los documentos HTML."

msgid "Default language for HTML documents."
msgstr "Idioma predeterminado de los documentos HTML."

msgid "Patterns to include for HTML index processing."
msgstr "Patrones que se incluyen en el procesamiento de indexación HTML."

msgid "Patterns to exclude for HTML index processing."
msgstr "Patrones que se excluyen del procesamiento de indexación HTML."

msgid "Patterns to include for HTML search processing."
msgstr "Patrones que se incluyen en el procesamiento de búsqueda HTML."

msgid "Patterns to exclude for HTML search processing."
msgstr "Patrones que se excluyen del procesamiento de búsqueda HTML."

msgid "Crawler File"
msgstr "Rastreador de archivos"

msgid "Encoding for file names in documents."
msgstr "Codificación de los nombres de archivo en los documentos."

msgid "Label to use when a file has no title."
msgstr "Etiqueta que se utiliza cuando un archivo no tiene título."

msgid "Whether to ignore files with empty content."
msgstr "Indica si se ignoran los archivos con contenido vacío."

msgid "Maximum length of file title in documents."
msgstr "Longitud máxima del título de archivo en los documentos."

msgid "Maximum length of file digest in documents."
msgstr "Longitud máxima del digest de archivo en los documentos."

msgid "Whether to append meta content from files."
msgstr "Indica si se anexa el contenido meta de los archivos."

msgid "Whether to append body content from files."
msgstr "Indica si se anexa el contenido del cuerpo de los archivos."

msgid "Default language for file documents."
msgstr "Idioma predeterminado de los documentos de archivo."

msgid "Patterns to include for file index processing."
msgstr "Patrones que se incluyen en el procesamiento de indexación de archivos."

msgid "Patterns to exclude for file index processing."
msgstr "Patrones que se excluyen del procesamiento de indexación de archivos."

msgid "Patterns to include for file search processing."
msgstr "Patrones que se incluyen en el procesamiento de búsqueda de archivos."

msgid "Patterns to exclude for file search processing."
msgstr "Patrones que se excluyen del procesamiento de búsqueda de archivos."

msgid "Whether to index the owner of crawled files (SMB, local file system and FTP). The crawl config parameter config.owner.enabled overrides it."
msgstr "Indica si se indexa el propietario de los archivos rastreados (SMB, sistema de archivos local y FTP). El parámetro de configuración de rastreo config.owner.enabled lo sobrescribe."

msgid "Whether to index the last modifier of crawled files, read from the document metadata and falling back to the file owner. The crawl config parameter config.last.modifier.enabled overrides it."
msgstr "Indica si se indexa el último modificador de los archivos rastreados, leído de los metadatos del documento y, en su defecto, del propietario del archivo. El parámetro de configuración de rastreo config.last.modifier.enabled lo sobrescribe."

msgid "Crawler Cache"
msgstr "Caché del rastreador"

msgid "Whether document cache is enabled."
msgstr "Indica si la caché de documentos está habilitada."

msgid "Maximum size (bytes) for document cache."
msgstr "Tamaño máximo (bytes) de la caché de documentos."

msgid "Supported MIME types for document cache."
msgstr "Tipos MIME admitidos para la caché de documentos."

msgid ",text/plain,application/xml,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation MIME types for HTML document cache."
msgstr ",text/plain,application/xml,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation Tipos MIME para la caché de documentos HTML."

msgid "Extension-to-MIME-type override mappings for MIME type detection (one per line: .ext=mime/type)."
msgstr "Mapeos de anulación de extensión a tipo MIME para la detección del tipo MIME (uno por línea: .ext=mime/type)."

msgid "Whether to extract text from images and scanned PDFs with Tesseract OCR (requires the tesseract command)."
msgstr "Indica si se extrae texto de imágenes y de PDF escaneados con Tesseract OCR (requiere el comando tesseract)."

msgid "Tesseract OCR languages, joined with '+' (e.g. jpn+eng)."
msgstr "Idiomas de Tesseract OCR, unidos con '+' (p. ej. jpn+eng)."

msgid "Timeout in seconds for one Tesseract OCR run."
msgstr "Tiempo de espera en segundos de una ejecución de Tesseract OCR."

msgid "Indexer"
msgstr "Indexador"

msgid "Whether to enable thread dump for the indexer."
msgstr "Indica si se habilita el volcado de hilos (thread dump) para el indexador."

msgid "Maximum number of unprocessed documents for the indexer."
msgstr "Número máximo de documentos sin procesar para el indexador."

msgid "Whether to enable click count tracking in the indexer."
msgstr "Indica si se habilita el seguimiento del recuento de clics en el indexador."

msgid "Whether to enable favorite count tracking in the indexer."
msgstr "Indica si se habilita el seguimiento del recuento de favoritos en el indexador."

msgid "Commit margin time (ms) for webfs in the indexer."
msgstr "Margen de tiempo de commit (ms) para webfs en el indexador."

msgid "Maximum number of empty lists for webfs in the indexer."
msgstr "Número máximo de listas vacías para webfs en el indexador."

msgid "Update interval (ms) for webfs in the indexer."
msgstr "Intervalo de actualización (ms) para webfs en el indexador."

msgid "Maximum document cache size for webfs in the indexer."
msgstr "Tamaño máximo de la caché de documentos para webfs en el indexador."

msgid "Maximum document request size (bytes) for webfs in the indexer."
msgstr "Tamaño máximo de solicitud de documentos (bytes) para webfs en el indexador."

msgid "Maximum document cache size for data in the indexer."
msgstr "Tamaño máximo de la caché de documentos para datos en el indexador."

msgid "Maximum document request size (bytes) for data in the indexer."
msgstr "Tamaño máximo de solicitud de documentos (bytes) para datos en el indexador."

msgid "Maximum delete cache size for data in the indexer."
msgstr "Tamaño máximo de la caché de eliminación para datos en el indexador."

msgid "Maximum redirect count for data in the indexer."
msgstr "Número máximo de redirecciones para datos en el indexador."

msgid "Fields used for language detection in the indexer."
msgstr "Campos utilizados para la detección de idioma en el indexador."

msgid "Length of text for language detection in the indexer."
msgstr "Longitud del texto para la detección de idioma en el indexador."

msgid "Maximum result window size for the indexer."
msgstr "Tamaño máximo de la ventana de resultados para el indexador."

msgid "Maximum number of search documents for the indexer."
msgstr "Número máximo de documentos de búsqueda para el indexador."

msgid "Index Settings"
msgstr "Configuración del índice"

msgid "Codec type for the index."
msgstr "Tipo de códec del índice."

msgid "Number of primary shards for the index."
msgstr "Número de shards primarios del índice."

msgid "Auto expand replicas setting for the index."
msgstr "Configuración de expansión automática de réplicas (auto expand replicas) del índice."

msgid "Digest algorithm for index IDs."
msgstr "Algoritmo de digest para los ID del índice."

msgid "Initial password for the index user."
msgstr "Contraseña inicial del usuario del índice."

msgid "Field Names"
msgstr "Nombres de campos"

msgid "Field name for favorite count in the index."
msgstr "Nombre del campo del recuento de favoritos en el índice."

msgid "Field name for click count in the index."
msgstr "Nombre del campo del recuento de clics en el índice."

