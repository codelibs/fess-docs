msgstr "Número máximo de contenidos de actualización de sugerencias."

msgid "Maximum document size for suggestion update."
msgstr "Tamaño máximo de documento para la actualización de sugerencias."

msgid "Scroll size for suggestion source reader."
msgstr "Tamaño de scroll del lector de la fuente de sugerencias."

msgid "Cache size for popular word suggestion."
msgstr "Tamaño de la caché para la sugerencia de palabras populares."

msgid "Cache expiration (seconds) for popular word suggestion."
msgstr "Caducidad de la caché (segundos) para la sugerencia de palabras populares."

msgid "Permissions for suggestion search log."
msgstr "Permisos del registro de búsqueda para la sugerencia."

msgid "Interval for system monitor in suggestion."
msgstr "Intervalo del monitor del sistema en la sugerencia."

