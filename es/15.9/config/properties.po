msgstr "Indica si la administración LDAP está habilitada."

msgid "User filter for LDAP admin."
msgstr "Filtro de usuarios para la administración LDAP."

msgid "Base DN for LDAP admin user."
msgstr "DN base del usuario de la administración LDAP."

msgid "Object classes for LDAP admin user."
msgstr "Clases de objeto del usuario de la administración LDAP."

msgid "Role filter for LDAP admin."
msgstr "Filtro de roles para la administración LDAP."

msgid "Base DN for LDAP admin role."
msgstr "DN base del rol de la administración LDAP."

msgid "Object classes for LDAP admin role."
msgstr "Clases de objeto del rol de la administración LDAP."

msgid "Group filter for LDAP admin."
msgstr "Filtro de grupos para la administración LDAP."

msgid "Base DN for LDAP admin group."
msgstr "DN base del grupo de la administración LDAP."

msgid "Object classes for LDAP admin group."
msgstr "Clases de objeto del grupo de la administración LDAP."

msgid "Whether to sync password for LDAP admin."
msgstr "Indica si se sincroniza la contraseña para la administración LDAP."

msgid "Whether to validate LDAP authentication."
msgstr "Indica si se valida la autenticación LDAP."

msgid "Timeout (milliseconds) to establish an LDAP connection. This also bounds the TLS handshake and the initial bind response. 0 or less leaves it to the JDK/OS default."
msgstr "Tiempo de espera (milisegundos) para establecer una conexión LDAP. También limita el handshake TLS y la respuesta del bind inicial. 0 o menos lo deja en el valor predeterminado del JDK/OS."

msgid "Timeout (milliseconds) to wait for an LDAP response after the connection is bound. 0 or less waits indefinitely."
msgstr "Tiempo de espera (milisegundos) de una respuesta LDAP una vez que la conexión está enlazada (bound). 0 o menos espera indefinidamente."

msgid "Server side time limit (milliseconds) for an LDAP search. 0 or less means no limit."
msgstr "Límite de tiempo del lado del servidor (milisegundos) para una búsqueda LDAP. 0 o menos significa sin límite."

msgid "Maximum username length for LDAP."
msgstr "Longitud máxima del nombre de usuario para LDAP."

msgid "Whether to ignore NetBIOS name in LDAP."
msgstr "Indica si se ignora el nombre NetBIOS en LDAP."

msgid "Whether to allow underscores in LDAP group names."
msgstr "Indica si se permiten guiones bajos en los nombres de grupo de LDAP."

msgid "Whether to use lowercase for LDAP permission names."
msgstr "Indica si se usan minúsculas para los nombres de permisos de LDAP."

msgid "Whether to allow empty permissions in LDAP."
msgstr "Indica si se permiten permisos vacíos en LDAP."

msgid "Whether to use samAccountName for LDAP group."
msgstr "Indica si se usa samAccountName para el grupo de LDAP."

msgid "Whether LDAP role search for user is enabled."
msgstr "Indica si la búsqueda de roles LDAP para el usuario está habilitada."

msgid "Whether LDAP role search for group is enabled."
msgstr "Indica si la búsqueda de roles LDAP para el grupo está habilitada."

msgid "Whether LDAP role search for role is enabled."
msgstr "Indica si la búsqueda de roles LDAP para el rol está habilitada."

