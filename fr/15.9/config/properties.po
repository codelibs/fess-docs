# Translations for the generated configuration properties page.
#
# msgid is the English text from fess_config.properties. Leave msgstr empty to
# render the English. Regenerate with tools/update_properties_doc.sh, which adds
# new entries and keeps the translations already here.
msgid ""
msgstr ""
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Core"
msgstr "Cœur"

msgid "The title of the domain for logging and display."
msgstr "Titre du domaine pour la journalisation et l'affichage."

msgid "Search Engine"
msgstr "Moteur de recherche"

msgid "The type of search engine backend. Valid values: default (OpenSearch with the CodeLibs plugins), vanilla (OpenSearch without the CodeLibs plugins), aws (vanilla with AWS-specific handling). cloud is a deprecated alias of vanilla."
msgstr "Type de backend du moteur de recherche. Valeurs valides : default (OpenSearch avec les plugins CodeLibs), vanilla (OpenSearch sans les plugins CodeLibs), aws (vanilla avec un traitement propre à AWS). cloud est un alias obsolète de vanilla."

msgid "The URL of the search engine HTTP endpoint. For IPv6 environments, use brackets around the IPv6 address (e.g., http://[::1]:9200)"
msgstr "URL du point de terminaison HTTP du moteur de recherche. Pour les environnements IPv6, utilisez des crochets autour de l'adresse IPv6 (par exemple, http://[::1]:9200)"

msgid "Path to SSL certificate authorities for secure HTTP connections."
msgstr "Chemin des autorités de certification SSL pour les connexions HTTP sécurisées."

msgid "Username for authenticating to the search engine."
msgstr "Nom d'utilisateur pour l'authentification auprès du moteur de recherche."

msgid "Password for authenticating to the search engine."
msgstr "Mot de passe pour l'authentification auprès du moteur de recherche."

msgid "Interval (ms) for heartbeat checks to the search engine."
msgstr "Intervalle (ms) des vérifications de heartbeat auprès du moteur de recherche."

msgid "Cipher algorithm used for encryption."
msgstr "Algorithme de chiffrement utilisé pour le chiffrement."

msgid "Secret key for encryption (change this value for production)."
msgstr "Clé secrète pour le chiffrement (modifiez cette valeur en production)."

msgid "Algorithm for digest calculation."
msgstr "Algorithme pour le calcul du digest."

msgid "Password hashing (new mechanism, Spring Security v5.8 compatible) Supported: bcrypt (only, as of now)"
msgstr "Hachage des mots de passe (nouveau mécanisme, compatible Spring Security v5.8) Pris en charge : bcrypt (uniquement, pour l'instant)"

msgid "BCrypt cost (log rounds). 10 matches Spring Security v5.8 default. Range: 4-31."
msgstr "Coût BCrypt (log rounds). 10 correspond à la valeur par défaut de Spring Security v5.8. Plage : 4-31."

msgid "Lazy re-hashing on successful login for legacy hashes."
msgstr "Re-hachage différé lors d'une connexion réussie pour les hachages hérités."

msgid "NOTE: app.digest.algorithm is kept for LEGACY password verification only (pre-upgrade hashes that have no {id} prefix). Do not use for new passwords. Regex pattern for properties to encrypt."
msgstr "REMARQUE : app.digest.algorithm est conservé uniquement pour la vérification des mots de passe HÉRITÉS (hachages antérieurs à la mise à niveau qui n'ont pas de préfixe {id}). Ne pas l'utiliser pour les nouveaux mots de passe. Motif d'expression régulière des propriétés à chiffrer."

msgid "Regex pattern for sensitive values to mask in debug logs (case-insensitive match against property/env keys)."
msgstr "Motif d'expression régulière des valeurs sensibles à masquer dans les journaux de débogage (correspondance insensible à la casse avec les clés de propriété/d'environnement)."

msgid "Extension names for application customization."
msgstr "Noms d'extension pour la personnalisation de l'application."

msgid "Audit log format."
msgstr "Format du journal d'audit."

msgid "Script audit log settings."
msgstr "Paramètres du journal d'audit des scripts."

msgid "Maximum characters of script text kept in a script audit log entry; longer text is truncated."
msgstr "Nombre maximum de caractères du texte de script conservés dans une entrée du journal d'audit des scripts ; un texte plus long est tronqué."

msgid "JVM options for the crawler process."
msgstr "Options JVM pour le processus du crawler."

msgid "JVM options (newline-separated) passed to the suggest creator child process."
msgstr "Options JVM (séparées par des sauts de ligne) transmises au processus enfant de création des suggestions."

msgid "JVM options for the chunk vector indexer process. Heap budget. This child JVM is only started while the \"Content Chunk Vector Indexer\" job runs, so a generous -Xmx costs nothing when content chunking is off. The live set is dominated by the in-flight batches, each of which retains, per document, the full _source, the document's chunk strings, and the document's embedding vectors: content_chunker.job.bulk_size          (default   20) x content_chunker.max_chunks_per_document (default 1000) x content_chunker.embedding.dimension  (default  768) x 4 bytes per float x content_chunker.job.concurrency      (default    2) = ~117 MB of vectors alone, before chunk strings and document sources. With the shipped defaults the worst case is roughly 190-250 MB live (and ~235 MB of vectors alone at dimension=1536), which does not fit a 256 MB heap with any GC headroom. Raise -Xmx further if you raise bulk_size, max_chunks_per_document, concurrency, or the embedding dimension."
msgstr "Options JVM pour le processus d'indexation des vecteurs de chunks. Budget de heap. Cette JVM enfant n'est démarrée que pendant l'exécution du job \"Content Chunk Vector Indexer\", donc un -Xmx généreux ne coûte rien lorsque le découpage du contenu en chunks est désactivé. L'ensemble actif est dominé par les lots en cours de traitement, dont chacun conserve, par document, le _source complet, les chaînes de chunks du document et les vecteurs d'embedding du document : content_chunker.job.bulk_size (par défaut 20) x content_chunker.max_chunks_per_document (par défaut 1000) x content_chunker.embedding.dimension (par défaut 768) x 4 octets par float x content_chunker.job.concurrency (par défaut 2) = ~117 MB de vecteurs à eux seuls, avant les chaînes de chunks et les sources des documents. Avec les valeurs par défaut fournies, le pire cas représente environ 190-250 MB en mémoire active (et ~235 MB de vecteurs à eux seuls avec dimension=1536), ce qui ne tient pas dans un heap de 256 MB avec une marge suffisante pour le GC. Augmentez encore -Xmx si vous augmentez bulk_size, max_chunks_per_document, concurrency ou la dimension d'embedding."

msgid "JVM options for the thumbnail process."
msgstr "Options JVM pour le processus de vignettes."

msgid "Job"
msgstr "Job"

msgid "System job IDs for scheduled jobs."
msgstr "ID des jobs système pour les jobs planifiés."

msgid "Template for web crawler job title."
msgstr "Modèle de titre de job du crawler Web."

msgid "Template for file crawler job title."
msgstr "Modèle de titre de job du crawler de fichiers."

msgid "Template for data crawler job title."
msgstr "Modèle de titre de job du crawler de données."

msgid "Script template for job execution."
msgstr "Modèle de script pour l'exécution du job."

msgid "Maximum number of crawler processes."
msgstr "Nombre maximum de processus de crawler."

msgid "Default script language for jobs."
msgstr "Langage de script par défaut pour les jobs."

msgid "Pattern to filter system properties for jobs."
msgstr "Motif de filtrage des propriétés système pour les jobs."

msgid "Number of processors to use."
msgstr "Nombre de processeurs à utiliser."

msgid "Path to Java command."
msgstr "Chemin de la commande Java."

msgid "Path to Python command."
msgstr "Chemin de la commande Python."

msgid "Encoding for file paths."
msgstr "Encodage des chemins de fichiers."

msgid "Whether to use a dedicated temporary directory."
msgstr "Indique s'il faut utiliser un répertoire temporaire dédié."

msgid "Maximum length of log output."
msgstr "Longueur maximale de la sortie du journal."

msgid "Adaptive load control value."
msgstr "Valeur du contrôle de charge adaptatif."

msgid "CPU threshold (%) for web request load control. Returns 429 when CPU >= this value. (100: disabled)"
msgstr "Seuil CPU (%) pour le contrôle de charge des requêtes Web. Retourne 429 lorsque le CPU >= cette valeur. (100 : désactivé)"

msgid "CPU threshold (%) for API request load control. Returns 429 when CPU >= this value. (100: disabled)"
msgstr "Seuil CPU (%) pour le contrôle de charge des requêtes API. Retourne 429 lorsque le CPU >= cette valeur. (100 : désactivé)"

msgid "Interval (seconds) for monitoring OpenSearch CPU load."
msgstr "Intervalle (secondes) de surveillance de la charge CPU d'OpenSearch."

msgid "Supported languages."
msgstr "Langues prises en charge."

msgid "Length of API access token."
msgstr "Longueur du jeton d'accès de l'API."

msgid "API access token request parameter."
msgstr "Paramètre de requête du jeton d'accès de l'API."

msgid "Permissions for API admin access."
msgstr "Permissions pour l'accès administrateur de l'API."

msgid "Accepted referers for API search."
msgstr "Referers acceptés pour la recherche de l'API."

msgid "Whether to enable scroll for API search."
msgstr "Indique s'il faut activer le scroll pour la recherche de l'API."

msgid "Whether to enable the end-user export of search results (CSV/JSON) at /api/v2/documents/export."
msgstr "Indique s'il faut activer l'exportation par l'utilisateur final des résultats de recherche (CSV/JSON) sur /api/v2/documents/export."

msgid "Maximum number of documents written by one search result export."
msgstr "Nombre maximum de documents écrits par une exportation de résultats de recherche."

msgid "Fields written by the search result export (comma-separated). A field that is not an API response field is ignored."
msgstr "Champs écrits par l'exportation des résultats de recherche (séparés par des virgules). Un champ qui n'est pas un champ de réponse de l'API est ignoré."

msgid "Maximum number of search result exports per minute for each user (each client IP for a guest). 0 or less disables the limit."
msgstr "Nombre maximum d'exportations de résultats de recherche par minute pour chaque utilisateur (chaque IP cliente pour un invité). 0 ou moins désactive la limite."

msgid "Headers for API JSON response. Access-Control-* and Timing-Allow-Origin are ignored here (CORS is controlled by api.cors.* / CorsFilter). Do not set Vary."
msgstr "En-têtes de la réponse JSON de l'API. Access-Control-* et Timing-Allow-Origin sont ignorés ici (CORS est contrôlé par api.cors.* / CorsFilter). Ne définissez pas Vary."

msgid "Whether to include exceptions in API JSON response."
msgstr "Indique s'il faut inclure les exceptions dans la réponse JSON de l'API."

msgid "Headers for API GSA response. Access-Control-* and Timing-Allow-Origin are ignored here (CORS is controlled by api.cors.* / CorsFilter). Do not set Vary."
msgstr "En-têtes de la réponse GSA de l'API. Access-Control-* et Timing-Allow-Origin sont ignorés ici (CORS est contrôlé par api.cors.* / CorsFilter). Ne définissez pas Vary."

msgid "Whether to include exceptions in API GSA response."
msgstr "Indique s'il faut inclure les exceptions dans la réponse GSA de l'API."

msgid "Headers for API dashboard response. Access-Control-* and Timing-Allow-Origin are ignored here (CORS is controlled by api.cors.* / CorsFilter). Do not set Vary."
msgstr "En-têtes de la réponse du tableau de bord de l'API. Access-Control-* et Timing-Allow-Origin sont ignorés ici (CORS est contrôlé par api.cors.* / CorsFilter). Ne définissez pas Vary."

msgid "Allowed origins for CORS. \"*\" returns a literal \"*\" (the request Origin is NOT reflected) and disables credentials. Set explicit origins (newline- or comma-separated) to allow credentialed cross-origin access."
msgstr "Origines autorisées pour CORS. \"*\" retourne un \"*\" littéral (l'Origin de la requête n'est PAS reflétée) et désactive les identifiants. Définissez des origines explicites (séparées par des sauts de ligne ou des virgules) pour autoriser l'accès cross-origin avec identifiants."

msgid "Allowed HTTP methods for CORS."
msgstr "Méthodes HTTP autorisées pour CORS."

msgid "Max age for CORS preflight requests."
msgstr "Âge maximal des requêtes preflight CORS."

msgid "Allowed request headers for CORS preflight. A static list is returned (Access-Control-Request-Headers is not reflected). Includes X-Fess-CSRF-Token for cross-origin SPAs sending the CSRF token."
msgstr "En-têtes de requête autorisés pour le preflight CORS. Une liste statique est retournée (Access-Control-Request-Headers n'est pas reflété). Inclut X-Fess-CSRF-Token pour les SPA cross-origin qui envoient le jeton CSRF."

msgid "Whether to allow credentials for CORS. Honored only for an exact match of an explicit Origin; ignored when api.cors.allow.origin is \"*\"."
msgstr "Indique s'il faut autoriser les identifiants pour CORS. Pris en compte uniquement pour une correspondance exacte avec une Origin explicite ; ignoré lorsque api.cors.allow.origin vaut \"*\"."

msgid "Whether to enable JSONP for API."
msgstr "Indique s'il faut activer JSONP pour l'API."

msgid "Fields for API ping to search engine."
msgstr "Champs pour le ping de l'API vers le moteur de recherche."

msgid "Rate Limiting"
msgstr "Limitation de débit"

msgid "Whether rate limiting is enabled."
msgstr "Indique si la limitation de débit est activée."

msgid "Maximum number of requests allowed per window."
msgstr "Nombre maximum de requêtes autorisées par fenêtre."

msgid "Window size in milliseconds."
msgstr "Taille de la fenêtre en millisecondes."

msgid "Duration in milliseconds to block IP when limit exceeded."
msgstr "Durée en millisecondes de blocage de l'IP lorsque la limite est dépassée."

msgid "Retry-After header value in seconds."
msgstr "Valeur de l'en-tête Retry-After en secondes."

msgid "Comma-separated list of whitelisted IPs (e.g., 127.0.0.1,::1)."
msgstr "Liste séparée par des virgules des IP figurant dans la liste d'autorisation (par exemple, 127.0.0.1,::1)."

msgid "Comma-separated list of blocked IPs."
msgstr "Liste séparée par des virgules des IP bloquées."

msgid "Comma-separated list of trusted proxy IPs. Only trust X-Forwarded-For/X-Real-IP from these IPs."
msgstr "Liste séparée par des virgules des IP de proxy de confiance. Ne faire confiance à X-Forwarded-For/X-Real-IP que s'ils proviennent de ces IP."

msgid "Number of requests between cleanup operations to prevent memory leaks."
msgstr "Nombre de requêtes entre les opérations de nettoyage pour éviter les fuites de mémoire."

msgid "Virtual Host: Host:fess.codelibs.org=fess"
msgstr "Hôte virtuel : Host:fess.codelibs.org=fess"

msgid "Hostname for the HTTP proxy server."
msgstr "Nom d'hôte du serveur proxy HTTP."

msgid "Port number for the HTTP proxy server (e.g., 8080)."
msgstr "Numéro de port du serveur proxy HTTP (par exemple, 8080)."

msgid "Username for HTTP proxy authentication."
msgstr "Nom d'utilisateur pour l'authentification auprès du proxy HTTP."

msgid "Password for HTTP proxy authentication."
msgstr "Mot de passe pour l'authentification auprès du proxy HTTP."

msgid "Maximum size (bytes) for HTTP file uploads."
msgstr "Taille maximale (octets) des téléversements de fichiers HTTP."

msgid "Threshold size (bytes) for HTTP file upload buffering."
msgstr "Taille seuil (octets) pour la mise en tampon des téléversements de fichiers HTTP."

msgid "Maximum number of files allowed per HTTP upload."
msgstr "Nombre maximum de fichiers autorisés par téléversement HTTP."

msgid "Index"
msgstr "Index"

msgid "Crawler Common"
msgstr "Crawler commun"

msgid "Number of threads for HTTP crawling."
msgstr "Nombre de threads pour le crawl HTTP."

msgid "Serializer type for crawler data (e.g., kryo)."
msgstr "Type de sérialiseur pour les données du crawler (par exemple, kryo)."

msgid "Maximum length of site name in documents."
msgstr "Longueur maximale du nom de site dans les documents."

msgid "Encoding for site names in documents."
msgstr "Encodage des noms de site dans les documents."

msgid "Hostname to use when unknown in documents."
msgstr "Nom d'hôte à utiliser lorsqu'il est inconnu dans les documents."

msgid "Whether to use site encoding for English documents."
msgstr "Indique s'il faut utiliser l'encodage du site pour les documents en anglais."

msgid "Whether to append data to documents."
msgstr "Indique s'il faut ajouter des données aux documents."

msgid "Whether to append filename to documents."
msgstr "Indique s'il faut ajouter le nom de fichier aux documents."

msgid "Maximum size of alphanumeric terms in documents."
msgstr "Taille maximale des mots alphanumériques dans les documents."

msgid "Maximum size of symbol terms in documents."
msgstr "Taille maximale des mots symboles dans les documents."

msgid "Whether to remove duplicate terms in documents."
msgstr "Indique s'il faut supprimer les mots en double dans les documents."

msgid "Unicode space characters for document parsing."
msgstr "Caractères d'espace Unicode pour l'analyse des documents."

msgid "Unicode full stop characters for document parsing."
msgstr "Caractères de point final Unicode pour l'analyse des documents."

msgid "Encoding for crawling data."
msgstr "Encodage des données de crawl."

msgid "Supported web protocols for crawling."
msgstr "Protocoles Web pris en charge pour le crawl."

msgid "Supported file protocols for crawling."
msgstr "Protocoles de fichiers pris en charge pour le crawl."

msgid "Pattern for environment variable keys in crawling data."
msgstr "Motif des clés de variables d'environnement dans les données de crawl."

msgid "Whether to ignore robots.txt during crawling."
msgstr "Indique s'il faut ignorer robots.txt pendant le crawl."

msgid "Whether to ignore robots meta tags during crawling."
msgstr "Indique s'il faut ignorer les balises meta robots pendant le crawl."

msgid "Whether to ignore content exceptions during crawling."
msgstr "Indique s'il faut ignorer les exceptions de contenu pendant le crawl."

msgid "HTTP status codes considered as failure URLs."
msgstr "Codes d'état HTTP considérés comme des URL en échec."

msgid "Interval (seconds) for system monitor during crawling."
msgstr "Intervalle (secondes) du moniteur système pendant le crawl."

msgid "Whether to ignore idle threads in hot thread monitoring."
msgstr "Indique s'il faut ignorer les threads inactifs dans la surveillance des hot threads."

msgid "Interval for hot thread monitoring (e.g., 500ms)."
msgstr "Intervalle de la surveillance des hot threads (par exemple, 500ms)."

msgid "Number of snapshots for hot thread monitoring."
msgstr "Nombre de snapshots pour la surveillance des hot threads."

msgid "Number of threads for hot thread monitoring."
msgstr "Nombre de threads pour la surveillance des hot threads."

msgid "Timeout for hot thread monitoring (e.g., 30s)."
msgstr "Délai d'expiration de la surveillance des hot threads (par exemple, 30s)."

msgid "Type of hot thread monitoring (e.g., cpu)."
msgstr "Type de surveillance des hot threads (par exemple, cpu)."

msgid "Metadata fields to exclude from document content."
msgstr "Champs de métadonnées à exclure du contenu du document."

msgid "Mapping for document metadata names."
msgstr "Mappage des noms de métadonnées du document."

msgid "Crawler HTML"
msgstr "Crawler HTML"

msgid "XPath to extract main content from HTML documents."
msgstr "XPath pour extraire le contenu principal des documents HTML."

msgid "XPath to extract language attribute from HTML documents."
msgstr "XPath pour extraire l'attribut de langue des documents HTML."

msgid "XPath to extract digest (description) from HTML documents."
msgstr "XPath pour extraire le digest (description) des documents HTML."

msgid "XPath to extract canonical URL from HTML documents."
msgstr "XPath pour extraire l'URL canonique des documents HTML."

msgid "HTML tags to prune (remove) during document processing."
msgstr "Balises HTML à élaguer (supprimer) pendant le traitement des documents."

msgid "Maximum length of digest extracted from HTML documents."
msgstr "Longueur maximale du digest extrait des documents HTML."

msgid "Default language for HTML documents."
msgstr "Langue par défaut des documents HTML."

msgid "Patterns to include for HTML index processing."
msgstr "Motifs à inclure pour le traitement d'indexation HTML."

msgid "Patterns to exclude for HTML index processing."
msgstr "Motifs à exclure pour le traitement d'indexation HTML."

msgid "Patterns to include for HTML search processing."
msgstr "Motifs à inclure pour le traitement de recherche HTML."

msgid "Patterns to exclude for HTML search processing."
msgstr "Motifs à exclure pour le traitement de recherche HTML."

msgid "Crawler File"
msgstr "Crawler de fichiers"

msgid "Encoding for file names in documents."
msgstr "Encodage des noms de fichiers dans les documents."

msgid "Label to use when a file has no title."
msgstr "Libellé à utiliser lorsqu'un fichier n'a pas de titre."

msgid "Whether to ignore files with empty content."
msgstr "Indique s'il faut ignorer les fichiers dont le contenu est vide."

msgid "Maximum length of file title in documents."
msgstr "Longueur maximale du titre de fichier dans les documents."

msgid "Maximum length of file digest in documents."
msgstr "Longueur maximale du digest de fichier dans les documents."

msgid "Whether to append meta content from files."
msgstr "Indique s'il faut ajouter le contenu des métadonnées des fichiers."

msgid "Whether to append body content from files."
msgstr "Indique s'il faut ajouter le contenu du corps des fichiers."

msgid "Default language for file documents."
msgstr "Langue par défaut des documents de fichiers."

msgid "Patterns to include for file index processing."
msgstr "Motifs à inclure pour le traitement d'indexation des fichiers."

msgid "Patterns to exclude for file index processing."
msgstr "Motifs à exclure pour le traitement d'indexation des fichiers."

msgid "Patterns to include for file search processing."
msgstr "Motifs à inclure pour le traitement de recherche des fichiers."

msgid "Patterns to exclude for file search processing."
msgstr "Motifs à exclure pour le traitement de recherche des fichiers."

msgid "Whether to index the owner of crawled files (SMB, local file system and FTP). The crawl config parameter config.owner.enabled overrides it."
msgstr "Indique s'il faut indexer le propriétaire des fichiers crawlés (SMB, système de fichiers local et FTP). Le paramètre de configuration de crawl config.owner.enabled prévaut sur cette valeur."

msgid "Whether to index the last modifier of crawled files, read from the document metadata and falling back to the file owner. The crawl config parameter config.last.modifier.enabled overrides it."
msgstr "Indique s'il faut indexer le dernier modificateur des fichiers crawlés, lu dans les métadonnées du document avec repli sur le propriétaire du fichier. Le paramètre de configuration de crawl config.last.modifier.enabled prévaut sur cette valeur."

msgid "Crawler Cache"
msgstr "Cache du crawler"

msgid "Whether document cache is enabled."
msgstr "Indique si le cache de documents est activé."

msgid "Maximum size (bytes) for document cache."
msgstr "Taille maximale (octets) du cache de documents."

msgid "Supported MIME types for document cache."
msgstr "Types MIME pris en charge pour le cache de documents."

msgid ",text/plain,application/xml,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation MIME types for HTML document cache."
msgstr ",text/plain,application/xml,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation Types MIME pour le cache de documents HTML."

msgid "Extension-to-MIME-type override mappings for MIME type detection (one per line: .ext=mime/type)."
msgstr "Mappages de remplacement extension vers type MIME pour la détection du type MIME (un par ligne : .ext=mime/type)."

msgid "Whether to extract text from images and scanned PDFs with Tesseract OCR (requires the tesseract command)."
msgstr "Indique s'il faut extraire le texte des images et des PDF numérisés avec Tesseract OCR (nécessite la commande tesseract)."

msgid "Tesseract OCR languages, joined with '+' (e.g. jpn+eng)."
msgstr "Langues de Tesseract OCR, jointes par '+' (par exemple jpn+eng)."

msgid "Timeout in seconds for one Tesseract OCR run."
msgstr "Délai d'expiration en secondes pour une exécution de Tesseract OCR."

msgid "Indexer"
msgstr "Indexeur"

msgid "Whether to enable thread dump for the indexer."
msgstr "Indique s'il faut activer le vidage de threads pour l'indexeur."

msgid "Maximum number of unprocessed documents for the indexer."
msgstr "Nombre maximum de documents non traités pour l'indexeur."

msgid "Whether to enable click count tracking in the indexer."
msgstr "Indique s'il faut activer le suivi du nombre de clics dans l'indexeur."

msgid "Whether to enable favorite count tracking in the indexer."
msgstr "Indique s'il faut activer le suivi du nombre de favoris dans l'indexeur."

msgid "Commit margin time (ms) for webfs in the indexer."
msgstr "Marge de temps de commit (ms) pour webfs dans l'indexeur."

msgid "Maximum number of empty lists for webfs in the indexer."
msgstr "Nombre maximum de listes vides pour webfs dans l'indexeur."

msgid "Update interval (ms) for webfs in the indexer."
msgstr "Intervalle de mise à jour (ms) pour webfs dans l'indexeur."

msgid "Maximum document cache size for webfs in the indexer."
msgstr "Taille maximale du cache de documents pour webfs dans l'indexeur."

msgid "Maximum document request size (bytes) for webfs in the indexer."
msgstr "Taille maximale des requêtes de documents (octets) pour webfs dans l'indexeur."

msgid "Maximum document cache size for data in the indexer."
msgstr "Taille maximale du cache de documents pour data dans l'indexeur."

msgid "Maximum document request size (bytes) for data in the indexer."
msgstr "Taille maximale des requêtes de documents (octets) pour data dans l'indexeur."

msgid "Maximum delete cache size for data in the indexer."
msgstr "Taille maximale du cache de suppression pour data dans l'indexeur."

msgid "Maximum redirect count for data in the indexer."
msgstr "Nombre maximum de redirections pour data dans l'indexeur."

msgid "Fields used for language detection in the indexer."
msgstr "Champs utilisés pour la détection de langue dans l'indexeur."

msgid "Length of text for language detection in the indexer."
msgstr "Longueur du texte pour la détection de langue dans l'indexeur."

msgid "Maximum result window size for the indexer."
msgstr "Taille maximale de la fenêtre de résultats pour l'indexeur."

msgid "Maximum number of search documents for the indexer."
msgstr "Nombre maximum de documents de recherche pour l'indexeur."

msgid "Index Settings"
msgstr "Paramètres de l'index"

msgid "Codec type for the index."
msgstr "Type de codec pour l'index."

msgid "Number of primary shards for the index."
msgstr "Nombre de shards primaires pour l'index."

msgid "Auto expand replicas setting for the index."
msgstr "Paramètre d'expansion automatique des répliques pour l'index."

msgid "Digest algorithm for index IDs."
msgstr "Algorithme de digest pour les ID d'index."

msgid "Initial password for the index user."
msgstr "Mot de passe initial de l'utilisateur de l'index."

msgid "Field Names"
msgstr "Noms de champs"

msgid "Field name for favorite count in the index."
msgstr "Nom du champ pour le nombre de favoris dans l'index."

msgid "Field name for click count in the index."
msgstr "Nom du champ pour le nombre de clics dans l'index."

msgid "Field name for config ID in the index."
msgstr "Nom du champ pour l'ID de configuration dans l'index."

msgid "Field name for expiration date in the index."
msgstr "Nom du champ pour la date d'expiration dans l'index."

msgid "Field name for URL in the index."
msgstr "Nom du champ pour l'URL dans l'index."

