msgid "Timeout (milliseconds) to wait for an LDAP response after the connection is bound. 0 or less waits indefinitely."
msgstr "Délai d'expiration (millisecondes) d'attente d'une réponse LDAP une fois la connexion liée. 0 ou moins attend indéfiniment."

msgid "Server side time limit (milliseconds) for an LDAP search. 0 or less means no limit."
msgstr "Limite de temps côté serveur (millisecondes) pour une recherche LDAP. 0 ou moins signifie aucune limite."

msgid "Maximum username length for LDAP."
msgstr "Longueur maximale du nom d'utilisateur pour LDAP."

msgid "Whether to ignore NetBIOS name in LDAP."
msgstr "Indique s'il faut ignorer le nom NetBIOS dans LDAP."

msgid "Whether to allow underscores in LDAP group names."
msgstr "Indique s'il faut autoriser les traits de soulignement dans les noms de groupes LDAP."

msgid "Whether to use lowercase for LDAP permission names."
msgstr "Indique s'il faut utiliser des minuscules pour les noms de permissions LDAP."

msgid "Whether to allow empty permissions in LDAP."
msgstr "Indique s'il faut autoriser les permissions vides dans LDAP."

msgid "Whether to use samAccountName for LDAP group."
msgstr "Indique s'il faut utiliser samAccountName pour le groupe LDAP."

msgid "Whether LDAP role search for user is enabled."
msgstr "Indique si la recherche de rôles LDAP pour l'utilisateur est activée."

msgid "Whether LDAP role search for group is enabled."
msgstr "Indique si la recherche de rôles LDAP pour le groupe est activée."

msgid "Whether LDAP role search for role is enabled."
msgstr "Indique si la recherche de rôles LDAP pour le rôle est activée."

